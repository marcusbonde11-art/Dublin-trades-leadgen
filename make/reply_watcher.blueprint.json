{
  "name": "LeadGen – Reply & Sent Watcher (every 4h)",
  "metadata": {
    "version": 1,
    "instant": false,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    }
  },
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:makeAPICall",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 11391947
      },
      "mapper": {
        "url": "spreadsheets/1KVkBKzi4XFJtNQ1ySj7DWp4tAMojxOUZoFXxIM1qtTg/values/Pipeline!T2:T",
        "method": "GET",
        "qs": [
          {
            "key": "majorDimension",
            "value": "COLUMNS"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "note": "Active outreach thread IDs from the tracker (column T)"
      }
    },
    {
      "id": 2,
      "module": "google-email:makeAnApiCall",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 11391672
      },
      "mapper": {
        "url": "/v1/users/me/messages",
        "method": "GET",
        "qs": [
          {
            "key": "q",
            "value": "newer_than:3d -label:outreach-processed -in:drafts -category:promotions -category:social"
          },
          {
            "key": "maxResults",
            "value": "500"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "note": "Recent unprocessed messages (IDs + thread IDs only)"
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{reverse(2.body.messages)}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "google-email:makeAnApiCall",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 11391672
      },
      "filter": {
        "name": "Only messages in a tracked outreach thread",
        "conditions": [
          [
            {
              "a": "{{contains(1.body.values[1]; 3.threadId)}}",
              "o": "text:equal",
              "b": "true"
            }
          ]
        ]
      },
      "mapper": {
        "url": "/v1/users/me/messages/{{3.id}}?format=metadata&metadataHeaders=From&metadataHeaders=Subject",
        "method": "GET"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 11391947
      },
      "mapper": {
        "from": "drive",
        "spreadsheetId": "1KVkBKzi4XFJtNQ1ySj7DWp4tAMojxOUZoFXxIM1qtTg",
        "sheetId": "Pipeline",
        "includesHeaders": true,
        "tableFirstRow": "A1:BZ1",
        "filter": [
          [
            {
              "a": "T",
              "o": "text:equal",
              "b": "{{3.threadId}}"
            }
          ]
        ],
        "limit": 1
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "variables": [
          {
            "name": "row",
            "value": "{{5.`__ROW_NUMBER__`}}"
          },
          {
            "name": "business",
            "value": "{{5.`1`}}"
          },
          {
            "name": "status",
            "value": "{{5.`10`}}"
          },
          {
            "name": "hook",
            "value": "{{5.`16`}}"
          },
          {
            "name": "history",
            "value": "{{5.`27`}}"
          },
          {
            "name": "from",
            "value": "{{get(map(4.body.payload.headers; \"value\"; \"name\"; \"From\"); 1)}}"
          },
          {
            "name": "subject",
            "value": "{{get(map(4.body.payload.headers; \"value\"; \"name\"; \"Subject\"); 1)}}"
          },
          {
            "name": "snippet",
            "value": "{{4.body.snippet}}"
          },
          {
            "name": "is_sent",
            "value": "{{contains(4.body.labelIds; \"SENT\")}}"
          },
          {
            "name": "today",
            "value": "{{formatDate(now; \"YYYY-MM-DD\"; \"America/New_York\")}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      }
    },
    {
      "id": 7,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "variables": [
          {
            "name": "bounce_m",
            "value": "{{contains(lower(6.from); \"mailer-daemon\")}} {{contains(lower(6.from); \"postmaster\")}} {{contains(lower(6.subject); \"delivery status notification\")}} {{contains(lower(6.subject); \"undeliverable\")}} {{contains(lower(6.subject); \"delivery failure\")}} {{contains(lower(6.subject); \"returned mail\")}}"
          },
          {
            "name": "auto_m",
            "value": "{{contains(lower(6.subject); \"out of office\")}} {{contains(lower(6.subject); \"automatic reply\")}} {{contains(lower(6.subject); \"auto-reply\")}} {{contains(lower(6.subject); \"autoreply\")}} {{contains(lower(6.subject); \"auto reply\")}} {{contains(lower(6.subject); \"away from\")}} {{contains(lower(6.subject); \"vacation\")}}"
          },
          {
            "name": "optout_m",
            "value": "{{contains(lower(6.snippet); \"unsubscribe\")}} {{contains(lower(6.snippet); \"remove me\")}} {{contains(lower(6.snippet); \"not interested\")}} {{contains(lower(6.snippet); \"no thanks\")}} {{contains(lower(6.snippet); \"no thank you\")}} {{contains(lower(6.snippet); \"stop email\")}} {{contains(lower(6.snippet); \"do not contact\")}} {{contains(lower(6.snippet); \"don&#39;t contact\")}} {{contains(lower(6.snippet); \"don't contact\")}} {{contains(lower(6.snippet); \"dont contact\")}} {{contains(lower(6.snippet); \"take me off\")}} {{contains(lower(6.snippet); \"please stop\")}} {{contains(lower(6.snippet); \"not a fit\")}} {{contains(lower(6.snippet); \"no longer contact\")}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        }
      }
    },
    {
      "id": 8,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "variables": [
          {
            "name": "type",
            "value": "{{if(6.is_sent; \"sent\"; if(contains(7.bounce_m; \"true\"); \"bounce\"; if(contains(7.auto_m; \"true\"); \"auto_reply\"; if(contains(7.optout_m; \"true\"); \"opt_out\"; \"reply\"))))}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        }
      }
    },
    {
      "id": 9,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 11391947
      },
      "mapper": {
        "mode": "select",
        "from": "drive",
        "spreadsheetId": "1KVkBKzi4XFJtNQ1ySj7DWp4tAMojxOUZoFXxIM1qtTg",
        "sheetId": "Pipeline",
        "includesHeaders": true,
        "useColumnHeaders": false,
        "rowNumber": "{{6.row}}",
        "valueInputOption": "RAW",
        "values": {
          "10": "{{if(6.status = \"Do-not-contact\"; 6.status; switch(8.type; \"sent\"; switch(6.status; \"Drafted\"; \"Sent\"; \"Follow-up 1 drafted\"; \"Follow-up 1 sent\"; \"Follow-up 2 drafted\"; \"Follow-up 2 sent\"; 6.status); \"bounce\"; \"Bounced\"; \"opt_out\"; \"Do-not-contact\"; \"reply\"; \"Replied\"; 6.status))}}",
          "11": "{{6.today}}",
          "20": "{{if(8.type = \"sent\"; if(5.`20`; 5.`20`; 6.today); 5.`20`)}}",
          "21": "{{if(8.type = \"sent\"; if(6.status = \"Follow-up 1 drafted\"; 6.today; 5.`21`); 5.`21`)}}",
          "22": "{{if(8.type = \"sent\"; if(6.status = \"Follow-up 2 drafted\"; 6.today; 5.`22`); 5.`22`)}}",
          "23": "{{if(8.type = \"sent\"; 5.`23`; 6.today)}}",
          "24": "{{if(8.type = \"sent\"; 5.`24`; 8.type)}}",
          "25": "{{if(8.type = \"sent\"; 5.`25`; substring(6.snippet; 0; 300))}}",
          "26": "{{switch(8.type; \"sent\"; \"Wait (follow-up drafted automatically when due)\"; \"reply\"; \"REPLY TO THEM - see alert email\"; \"opt_out\"; \"None - do not contact again\"; \"bounce\"; \"Address bounced - find another way to reach them\"; \"auto_reply\"; \"Auto-reply only - follow-up timing continues\"; 5.`26`)}}",
          "27": "{{6.history}}\n{{6.today}} {{8.type}}: {{substring(6.snippet; 0; 80)}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 2400,
          "y": 0
        }
      }
    },
    {
      "id": 10,
      "module": "google-email:makeAnApiCall",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 11391672
      },
      "mapper": {
        "url": "/v1/users/me/messages/{{3.id}}/modify",
        "method": "POST",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"addLabelIds\":[\"Label_24\"]}"
      },
      "metadata": {
        "designer": {
          "x": 2700,
          "y": 0
        },
        "note": "Mark message processed so it is never handled twice"
      }
    },
    {
      "id": 11,
      "module": "google-email:makeAnApiCall",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 11391672
      },
      "filter": {
        "name": "Real reply or opt-out",
        "conditions": [
          [
            {
              "a": "{{8.type}}",
              "o": "text:equal",
              "b": "reply"
            }
          ],
          [
            {
              "a": "{{8.type}}",
              "o": "text:equal",
              "b": "opt_out"
            }
          ]
        ]
      },
      "mapper": {
        "url": "/v1/users/me/threads/{{3.threadId}}/modify",
        "method": "POST",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"addLabelIds\":[\"Label_23\",\"STARRED\",\"IMPORTANT\"]}"
      },
      "metadata": {
        "designer": {
          "x": 3000,
          "y": 0
        }
      }
    },
    {
      "id": 12,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 11391672
      },
      "mapper": {
        "to": [
          "marcusbonde11@gmail.com"
        ],
        "subject": "[Lead reply] {{6.business}} – {{if(8.type = \"opt_out\"; \"asked not to be contacted\"; \"replied\")}}",
        "bodyType": "rawHtml",
        "content": "<p><b>{{6.business}}</b> {{if(8.type = \"opt_out\"; \"asked not to be contacted. They are now marked Do-not-contact; no reply needed unless you want to say thanks.\"; \"replied to your outreach.\")}}</p><p><b>From:</b> {{replace(replace(6.from; \"<\"; \"(\"); \">\"; \")\")}}<br><b>Subject:</b> {{6.subject}}</p><blockquote>{{6.snippet}}</blockquote><p><b>Your angle for them:</b> {{6.hook}}</p><p><a href=\"https://mail.google.com/mail/u/0/#all/{{3.threadId}}\">Open the conversation</a> · <a href=\"https://docs.google.com/spreadsheets/d/1KVkBKzi4XFJtNQ1ySj7DWp4tAMojxOUZoFXxIM1qtTg/edit#gid=1601273399&range=A{{6.row}}\">Open their row in the tracker</a></p><p style=\"color:#888\">Sent by your LeadGen reply watcher (Make.com).</p>"
      },
      "metadata": {
        "designer": {
          "x": 3300,
          "y": 0
        }
      }
    }
  ]
}